# ── Firebase Auth (client-side keys, NEXT_PUBLIC_ is fine) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Payment gateway (SERVER ONLY — never prefix with NEXT_PUBLIC_) ──
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ── MetaApi (SERVER ONLY) ──
METAAPI_TOKEN=
METAAPI_REGION=

# ── Admin panel access (comma separated Gmail/emails) ──
NEXT_PUBLIC_ADMIN_EMAILS=
